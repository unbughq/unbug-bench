+++ b/src/workflows/express-order.ts
@@ -0,0 +1,26 @@
+import { createStep, createWorkflow, StepResponse, WorkflowResponse } from "@medusajs/framework/workflows-sdk"
+import { ContainerRegistrationKeys, Modules } from "@medusajs/framework/utils"
+import { createOrderWorkflow } from "@medusajs/medusa/core-flows"
+
+// Express checkout: the order is created directly, then a new step writes all of its
+// reservations in one batch (replacing the cart checkout's reserve-inventory step).
+const reserveOrderBatchStep = createStep("reserve-order-batch", async (orderId: string, { container }) => {
+  const query = container.resolve(ContainerRegistrationKeys.QUERY)
+  const { data: [order] } = await query.graph({ entity: "order", filters: { id: orderId }, fields: [
+    "items.*", "items.variant.manage_inventory", "items.variant.allow_backorder",
+    "items.variant.inventory_items.required_quantity", "items.variant.inventory_items.inventory_item_id"] })
+  const rows = (order?.items ?? []).flatMap((item: any) => !item.variant?.manage_inventory ? [] :
+    item.variant.inventory_items.map((link: any) => ({ line_item_id: item.id, inventory_item_id: link.inventory_item_id,
+      location_id: "sloc_bench", quantity: Number(item.quantity) * Number(link.required_quantity),
+      allow_backorder: !!item.variant.allow_backorder })))
+  const created: any[] = rows.length ? await container.resolve(Modules.INVENTORY).createReservationItems(rows) : []
+  return new StepResponse(created, created.map((r) => r.id))
+}, async (ids: string[] | undefined, { container }) => {
+  if (ids?.length) await container.resolve(Modules.INVENTORY).deleteReservationItems(ids)
+})
+
+export const expressOrderWorkflow = createWorkflow("express-order", (input: any) => {
+  const order = createOrderWorkflow.runAsStep({ input })
+  reserveOrderBatchStep(order.id)
+  return new WorkflowResponse(order)
+})
