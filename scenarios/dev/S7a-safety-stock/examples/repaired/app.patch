new file mode 100644
--- /dev/null
+++ b/src/api/middlewares.ts
@@ -0,0 +1,17 @@
+import "../reference-checkpoints";
+import { defineMiddlewares, errorHandler } from "@medusajs/framework/http";
+import { MedusaError } from "@medusajs/framework/utils";
+
+const fallback = errorHandler();
+export default defineMiddlewares({
+  errorHandler: (error, req, res, next) => {
+    // Only the reference guard's explicit stock rejection is a business refusal.
+    // Other check violations and unexpected failures must remain server errors.
+    if (error.code === "23514" && error.constraint === "bench_reference_stock") {
+      error = new MedusaError(MedusaError.Types.NOT_ALLOWED,
+        "Insufficient stock for reservation");
+    }
+    return fallback(error, req, res, next);
+  },
+});
+
diff --git a/src/reference-checkpoints.ts b/src/reference-checkpoints.ts
new file mode 100644
--- /dev/null
+++ b/src/reference-checkpoints.ts
@@ -0,0 +1,13 @@
+import { DistributedTransaction } from "@medusajs/framework/orchestration";
+
+const save = DistributedTransaction.prototype.saveCheckpoint;
+const pending = new WeakMap<object, Promise<unknown>>();
+// Medusa 2.19's in-memory store rejects overlapping saves of one transaction.
+// Exhausted retries after a step succeeds abort order compensation. Serialize
+// before snapshotting, so sibling saves cannot also replace live step objects.
+DistributedTransaction.prototype.saveCheckpoint = function (...args) {
+  const previous = pending.get(this) ?? Promise.resolve();
+  const current = previous.catch(() => {}).then(() => save.apply(this, args));
+  pending.set(this, current);
+  return current;
+};
