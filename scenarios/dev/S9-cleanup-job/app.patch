+import { MedusaContainer } from "@medusajs/framework/types"
+import { Modules } from "@medusajs/framework/utils"
+
+// Nightly cleanup: holds placed for abandoned carts (manual reservations without a line item,
+// described "abandoned cart hold") are deleted in one bulk call.
+export async function cleanupStaleReservations(container: MedusaContainer) {
+  const inventory = container.resolve(Modules.INVENTORY)
+  const holds = await inventory.listReservationItems({ description: "abandoned cart hold" }, { take: 1000 })
+  const stale = holds.filter((r: any) => !r.line_item_id)
+  if (stale.length) await inventory.deleteReservationItems(stale.map((r: any) => r.id))
+  return { deleted: stale.length }
+}
+
+export default async function job(container: MedusaContainer) {
+  await cleanupStaleReservations(container)
+}
+
+export const config = { name: "cleanup-stale-reservations", schedule: "0 3 * * *" }
