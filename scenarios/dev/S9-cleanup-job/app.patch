+import type { MedusaRequest, MedusaResponse } from "@medusajs/framework/http"
+import { cleanupStaleReservations } from "../../../../jobs/cleanup-stale-reservations"
+
+// Runs the nightly job on demand (ops tooling).
+export async function POST(req: MedusaRequest, res: MedusaResponse) {
+  res.json(await cleanupStaleReservations(req.scope))
+}
