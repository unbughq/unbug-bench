# User unit (systemctl --user, as `user`): bin/stop_audit's result for the campaign guard, which only
# reads <state_dir>/stop-audit.json and alerts when it is stale. Install with unbug-stop-audit.timer.
# UNBUG_STOP_AUDIT_REPO: a plain clone of the git bundle of main shipped at deploy.
[Unit]
Description=Write the stop audit's result (is each factory bug class fixed?) for the campaign guard
[Service]
Type=oneshot
Environment=UNBUG_STOP_AUDIT_REPO=/home/user/unbug-bench-main
# Exit 1 means a REGRESSION or UNKNOWN was written; the guard alerts on it, so it is not a unit failure.
SuccessExitStatus=1
ExecStart=/usr/bin/timeout 120 /home/user/durable-qualification-20261105/venv/bin/python -B /home/user/durable-first-case-20261106/source-current/bin/stop_audit --config /home/user/durable-first-case-20261106/config.json --last-hours 24 --write /home/user/.unbug-durable/stop-audit.json
