[Unit]
Description=Unbug batch model admission on the control VM
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/unbug-bench
EnvironmentFile=/run/unbug-bench/router.env
UMask=0077
LimitCORE=0
ExecStart=/usr/bin/python3 -B /home/user/unbug-bench/factory/model_router.py --config /run/unbug-bench/router.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
