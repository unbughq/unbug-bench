[Unit]
Description=Cleanup for the authenticated serial pilot
After=network-online.target
[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/unbug-bench
Environment=HOME=/home/user UNBUG_CLOUD=boat
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077
LimitCORE=0
ExecStart=/usr/bin/python3 -B /home/user/unbug-bench/factory/practice_cleanup.py --batch
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/user/.unbug-control/pilot.env
[Install]
WantedBy=multi-user.target
