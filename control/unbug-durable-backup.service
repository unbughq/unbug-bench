[Unit]
Description=Encrypted durable factory backup
After=network-online.target

[Service]
Type=oneshot
User=user
Group=user
WorkingDirectory=/home/user/unbug-bench
ExecStart=/home/user/.unbug-durable/venv/bin/python -B factory/durable/operator.py --config /home/user/.unbug-durable/config.json backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
