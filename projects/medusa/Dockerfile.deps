# Dependency-only image: never includes app source, guards, build output or trial state.
FROM node:22.22.2-bookworm-slim
WORKDIR /app
ENV NODE_ENV=development MEDUSA_TELEMETRY_DISABLED=true NODE_OPTIONS=--max-old-space-size=1536
COPY package.json package-lock.json verify-lock.mjs ./
RUN node verify-lock.mjs && npm ci --no-audit --no-fund \
 && sha256sum package.json package-lock.json > /opt/medusa-deps.sha256
