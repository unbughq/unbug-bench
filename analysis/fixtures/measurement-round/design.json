  "sizing_rule": "After all frozen measurement cases are scored, fit equal-case random-effects covariances to log(1 + charged minutes) and unsafe checkpoint fractions per try. Use the measured-component generator in steadiness.py, retaining case, try and paired covariance, under a fixed planning alternative of 50% time saving and zero safety difference, at the measured baseline mean minutes. For 2 and 3 tries separately, scan the frozen case grid [24,36,48,72,96,128,192,256,384,512]. Use 2500 simulated studies and 999 paired case-then-try bootstrap draws per study, seed 20261017; apply fixed-sample rule C (one-sided 95%, saving >30%, safety <=+5 points, collapsed-safety guard). Select the first grid size whose Wilson 95% Monte Carlo LOWER power bound is at least 80%; stop that design's simulation scan there and report every tested grid point. Check moment reproduction and simulate each null boundary at the candidate size; withhold a recommendation if moments differ materially, any boundary rejection LOWER Monte Carlo bound exceeds 5%, safety is collapsed, or baseline minutes are zero. If none qualifies, report beyond 512/undetermined, never extrapolate. This sizes a future separately frozen round, never adds tries or cases to this measurement round, and is conditional on estimated components and the Gaussian summary model; it does not include component-estimation uncertainty.",
  "secondary_plan": {
    "chosen_before_scoring": true,
    "decision_use": "none; rule C alone decides",
    "bayesian_priors": {
      "sceptical": {
        "saving_mean": 0.0,
        "saving_sd": 0.35,
        "safety_mean": 0.0,
        "safety_sd": 0.1
      },
      "neutral_flat": {
        "saving_mean": 0.0,
        "saving_sd": 1.5,
        "safety_mean": 0.0,
        "safety_sd": 0.25
      },
      "optimistic": {
        "saving_mean": 0.5,
        "saving_sd": 0.35,
        "safety_mean": -0.03,
        "safety_sd": 0.1
      }
    },
    "bayesian_likelihood": "Joint Gaussian paired try summaries (B minutes/100, C minutes/100, C-B unsafe fraction), case and try covariance; bounded population effects, not bounded Gaussian observations",
    "bayesian_covariance_prior": "Independent inverse-Wishart G,W: df=5, scale=diag(.25,.25,.01); prior mean component SD scales 50 minutes, 50 minutes, 10 safety points; heavy tails; same for every effect prior",
    "bayesian_baseline_prior": "log(B population mean minutes/100) Normal(0,2.5); saving <1; safety difference in [-1,1]",
    "bayesian_draws_per_chain": 2000,
    "bayesian_burn_in": 1000,
    "bayesian_chains": 2,
    "calibration_studies_per_scenario": 49,
    "calibration_draws_per_chain": 600,
    "calibration_burn_in": 400,
    "calibration_prior": "sceptical",
    "calibration_seed": 20261019,
    "calibration_generator": "steadiness.generate_batch: binary checkpoints and discrete charges, base unsafe .15, base minutes 30/checkpoint, level 0; same 24-case unequal-try design as fixture",
    "calibration_note": "Shorter chains for computational calibration; record diagnostics and threshold Monte Carlo ambiguity. Model-conditional error rate, not a universal frequentist guarantee.",
    "mixed_model_bootstrap": 199,
    "logistic_quadrature_nodes_per_dimension": 5,
    "mixed_sizing_agreement": "Both fits must converge without singularity or quadrature sensitivity; each model marginal and paired variance within 25% of reference (absolute tolerance 1e-5). Reference cross-outcome covariance retained and resulting covariance projected PSD only if relative change <=10%. Reference sizes remain primary; model feeds a power sensitivity at the reference candidate sizes.",
    "cuped_folds": 4,
    "seed": 20261017,
    "subgroups": []
  },
