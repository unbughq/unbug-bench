#!/bin/sh
# Host: <base64 tar of decrypted secrets> | bin/push-secrets VM NAME...
# Unpacks into the VM's RAM (/dev/shm/secrets, mode 700/600; gone when the VM is deleted) and
# checks each NAME arrived. Launchers decrypt $UNBUG_SECRETS_FILE (made by bin/setup-secrets)
# once in memory and pipe it here; plaintext never touches this Mac's disk or any argv.
# Replaces boat's paid AI relay (off since 2026-10-16).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
merge=no
if [ "${1:-}" = --merge ]; then merge=yes; shift; fi
id=${1:?usage: push-secrets VM NAME...}; shift
for name in "$@"; do case $name in *[!A-Za-z0-9_.-]*|.*|'') echo "bad secret name $name" >&2; exit 1 ;; esac; done
# Linger keeps the user's login alive: otherwise systemd-logind (RemoveIPC) clears /dev/shm once the runner's
# session ends, and an in-place resume finds no keys (2026-10-18).
"$root/bin/boat-call" ssh "$id" "sudo loginctl enable-linger \$(id -un)" >/dev/null 2>&1 || true
cleanup="rm -rf /dev/shm/secrets && mkdir /dev/shm/secrets"
[ "$merge" = no ] || cleanup="mkdir -p /dev/shm/secrets"
"$root/bin/boat-call" --stdin ssh "$id" "umask 077; $cleanup && base64 -d | tar -x -C /dev/shm/secrets && cd /dev/shm/secrets && for n in $*; do test -s \"\$n\" || { echo \"missing secret \$n\" >&2; exit 1; }; done" >/dev/null
