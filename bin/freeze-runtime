#!/usr/bin/env python3
"""Capture non-secret runtime identities on the machine that runs the judge.

  bin/freeze-runtime --image unbug-bench-medusa:latest --image postgres:17.11-bookworm
No container environment, auth file, or Docker registry credentials are read.
"""
import argparse
import datetime
import json
import platform
import subprocess


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--image", action="append", required=True)
    args = parser.parse_args()
    images = []
    for name in args.image:
        image = json.loads(output("docker", "image", "inspect", name))[0]
        images.append({"reference": name, "id": image["Id"], "repo_digests": image.get("RepoDigests") or [],
                       "architecture": image["Architecture"], "os": image["Os"]})
    cpu = None
    try:
        from pathlib import Path
        cpu = next(line.split(":", 1)[1].strip() for line in Path("/proc/cpuinfo").read_text().splitlines() if line.startswith("model name"))
    except (OSError, StopIteration):
        pass
    print(json.dumps({"schema": 1, "captured_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                      "platform": {"system": platform.system(), "release": platform.release(),
                                   "architecture": platform.machine(), "cpu": cpu},
                      "python": platform.python_version(), "node": output("node", "--version"),
                      "docker": json.loads(output("docker", "version", "--format", "{{json .Server}}")),
                      "compose": output("docker", "compose", "version", "--short"),
                      "images": images}, indent=2))


if __name__ == "__main__":
    main()
