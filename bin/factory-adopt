#!/usr/bin/env python3
"""Host: bin/factory-adopt --hours H SERVER_ID...  Take over running factory VMs from their launchers.

Moves each server's `expires` label to now + H (+30 min for the sweeper), then polls every minute:
DONE -> factory/collect.sh + delete (what launch.sh does); past the deadline, or unreachable for
15 min -> collect what exists + delete. Used when a batch outlives launch.sh's TTL (2026-10-17: cases
needed ~5-6 h, launchers retire at 3 h 45). Stop the launchers with SIGKILL afterwards: their
INT/TERM trap would delete the VMs. Log lines go to stdout.
A parked case that stopped for a passing reason (stall, pause at the deadline, provider limit, CLI error) is resumed
in place automatically, at most ADOPT_AUTO_RESUMES (3) times per server; provider limits wait until 10 min before
the paid hour ends. Gate failures and budget caps are never auto-resumed (2026-10-18: stopped cases sat idle for hours).
"""
import json, os, pathlib, re, subprocess, sys, time

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "factory"))
from recovery import adopter_stop_reason
HB = os.environ.get("ADOPT_BOAT", str(ROOT / "bin/hcloud-boat"))  # tests pass a fake
env = dict(os.environ, BOAT_CMD=HB)


def say(*a): print(time.strftime("%H:%M:%S"), *a, flush=True)


MAX_AUTO = int(os.environ.get("ADOPT_AUTO_RESUMES", "3"))
RESUME_ARGS = os.environ.get("ADOPT_RESUME_ARGS", "--max-total-calls 2000").split()


def auto_resume_plan(card, labels, now):
    """(seconds to wait, why) for a parked case worth resuming, else (None, why)."""
    stop, n = card.get("terminal_stop") or "", int(labels.get("autoresumes", 0))
    reason = adopter_stop_reason(card)
    if reason: return None, reason
    if n >= MAX_AUTO: return None, f"auto-resume limit {MAX_AUTO} reached"
    wait = max(0, int(labels.get("expires", now)) - 600 - now) if stop.startswith("provider_limit") else 0
    return int(wait), f"auto-resume {n + 1}/{MAX_AUTO} after {stop}"


def maybe_resume(sid, case):
    try: card = json.loads((ROOT / "sealed" / f"{case}.scorecard.json").read_text())
    except (OSError, ValueError): return say(sid, "not auto-resumed: no collected scorecard for", case)
    d = run(["hcloud", "server", "describe", sid, "-o", "json"])
    labels = (json.loads(d.stdout).get("labels") or {}) if d.returncode == 0 else {}
    wait, why = auto_resume_plan(card, labels, time.time())
    if wait is None: return say(sid, "not auto-resumed:", why)
    run(["hcloud", "server", "add-label", "--overwrite", sid, f"autoresumes={int(labels.get('autoresumes', 0)) + 1}"])
    log = open(ROOT / "results/factory/adopt.log", "a")
    subprocess.Popen(["sh", "-c", f'sleep {wait}; exec "$0" "$@"', str(ROOT / "factory/resume-in-place.sh"), sid, *RESUME_ARGS],
                     stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    say(sid, why, f"in {wait // 60} min")


def run(cmd, timeout=120):
    try: return subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired: return subprocess.CompletedProcess(cmd, 124, "", "timeout")


def retire(sid, why):
    """Collect (3 tries; collect.sh verifies archive hashes), then delete. Never deletes a server whose work did not arrive."""
    for attempt in range(1, 4):
        c = run([str(ROOT / "factory/collect.sh"), sid], timeout=900)  # collect.sh checks archive hashes itself
        if c.returncode == 0: break
        say(sid, why, f"COLLECT FAILED try {attempt} ({c.returncode})", c.stderr.strip()[-300:])
        time.sleep(float(os.environ.get("ADOPT_RETRY", "30")))
    else:
        say(sid, "!!! KEPT RUNNING: work not collected intact; collect by hand (factory/collect.sh", sid + ") before deleting")
        return False
    say(sid, why, "collected", c.stdout.strip()[-600:])
    if HB == str(ROOT / "bin/hcloud-boat"):  # resumable case: keep the VM until its paid hour ends
        pk = run([str(ROOT / "bin/hcloud-park"), sid])
        if pk.returncode == 0:
            say(sid, "parked:", pk.stderr.strip())
            m = re.search(r"\((case-[^)]+)\)", pk.stderr)
            if m: maybe_resume(sid, m.group(1))
            return True
    d = run([HB, "delete", sid, "--yes"])
    say(sid, "deleted" if d.returncode == 0 else f"!!! DELETE FAILED, sweeper is the backstop: {d.stderr.strip()}")
    return True


def main():
    args = sys.argv[1:]
    if len(args) < 3 or args[0] != "--hours": sys.exit(__doc__)
    deadline = time.time() + float(args[1]) * 3600
    live = {sid: time.time() for sid in args[2:]}  # sid -> last successful poll
    dead = {}  # sid -> consecutive polls with no runner and no DONE
    for sid in live:
        r = run(["hcloud", "server", "add-label", "--overwrite", sid, f"expires={int(deadline + 1800)}"])
        if r.returncode: sys.exit(f"{sid}: could not set expires: {r.stderr.strip()}")
    say("adopted", " ".join(live), "deadline", time.strftime("%H:%M", time.localtime(deadline)))
    while live:
        for sid in list(live):
            p = run([HB, "ssh", sid, "test -f ~/sealed/DONE && echo DONE || { pgrep -f '^python3 .*factory/run.py' >/dev/null && echo RUNNING || echo DEAD; }"], timeout=60)
            if p.returncode == 0: live[sid] = time.time()
            dead[sid] = dead.get(sid, 0) + 1 if "DEAD" in p.stdout else 0
            if "DONE" in p.stdout: retire(sid, "done"); del live[sid]  # kept-running servers are reported, not retried
            elif dead[sid] >= 2: retire(sid, "runner exited without DONE"); del live[sid]  # crashed: don't idle to the deadline
            elif time.time() > deadline: retire(sid, "deadline reached"); del live[sid]
            elif time.time() - live[sid] > 900: retire(sid, "unreachable 15 min"); del live[sid]
        time.sleep(float(os.environ.get("ADOPT_POLL", "60")))
    say("all adopted servers retired")


if __name__ == "__main__":
    main()
