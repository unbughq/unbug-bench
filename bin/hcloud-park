#!/bin/sh
# Host: bin/hcloud-park SERVER_ID. After a successful collect: if the VM holds a resumable factory case (stopped,
# or failed a gate with its work kept by FACTORY_DEFER_WIPE), keep it until its paid hour ends instead of deleting
# it, labelled parked=<case-id>, so factory/resume-in-place.sh can continue it there without the founder key.
# Exit 0 = parked (caller must not delete); 1 = nothing to resume or too little paid time left (caller deletes).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
id=${1:?usage: hcloud-park SERVER_ID}
case_id=$(BOAT_CMD="$root/bin/hcloud-boat" "$root/bin/boat-call" ssh "$id" 'python3 - <<"PY"
import glob, json, os
for p in sorted(glob.glob(os.path.expanduser("~/sealed/case-*.scorecard.json"))):
    d = json.load(open(p))
    case = d.get("case", "")
    if (d.get("terminal_stop") or d.get("failed_gate")) and os.path.isdir(os.path.expanduser(f"~/work/{case}/case")):
        print(case)
PY' 2>/dev/null | tail -1) || exit 1
[ -n "$case_id" ] || exit 1
end=$(hcloud server describe "$id" -o json | python3 -c 'import datetime, json, math, sys, time
c = datetime.datetime.fromisoformat(json.load(sys.stdin)["created"].replace("Z", "+00:00")).timestamp()
hours = max(1, math.ceil((time.time() - c) / 3600))
print(int(c + hours * 3600 - 180))  # 3 min before the next billed hour starts')
[ $((end - $(date +%s))) -ge 300 ] || exit 1  # under 5 paid minutes left: not worth parking
hcloud server add-label --overwrite "$id" "parked=$case_id" >/dev/null
hcloud server add-label --overwrite "$id" "expires=$end" >/dev/null
echo "PARKED $id ($case_id) until $(date -r "$end" +%H:%M): factory/resume-in-place.sh $id" >&2
