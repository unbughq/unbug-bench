#!/bin/sh
# Founder: bin/setup-secrets            model credentials and statements key, fresh bundle
#          <founder identity> | bin/setup-secrets statements  add/keep the statement key
#          <founder identity> | bin/setup-secrets opencode [claude|codex|openrouter]...
#          <founder identity> | bin/setup-secrets claude-token-2  optional second account (exam only)
#          <founder identity> | bin/setup-secrets claude-factory-token-2 claude-factory-token-3  extra factory Claude subscriptions
#          <founder identity> | bin/setup-secrets r2              Cloudflare R2 checkpoint bucket (host-only)
#          <founder identity> | bin/setup-secrets opencode-2      second OpenCode Go account (opencode-go-key-2)
#                                       redo only those steps, keep the rest of the bundle
# Claude token, a dedicated Codex login, the OpenRouter key (optional) and the OpenCode Go key,
# age-encrypted to the founder recipient at $UNBUG_SECRETS_FILE (default
# ~/.config/unbug-bench/secrets.age). Prompts use the terminal; plaintext lives only in a
# private temp dir while this runs. Launches decrypt in memory with the identity on stdin.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
out=${UNBUG_SECRETS_FILE:-$HOME/.config/unbug-bench/secrets.age}
recipient=$(sed -n 's/^FOUNDER_RECIPIENT = "\(age1[a-z0-9]*\)".*/\1/p' "$root/factory/run.py")
[ -n "$recipient" ] || { echo "founder recipient not found in factory/run.py" >&2; exit 1; }
# Optional public control recipient; never add it to case/statement encryption.
control_recipient=${CONTROL_RECIPIENT:-}
if [ -z "$control_recipient" ] && [ -f "$root/factory/control-recipient.txt" ]; then
  control_recipient=$(cat "$root/factory/control-recipient.txt")
fi
if [ -n "$control_recipient" ]; then
  printf '%s\n' "$control_recipient" | python3 -c 'import re,sys; sys.exit(0 if re.fullmatch(r"age1[0-9a-z]{58}\n", sys.stdin.read()) else "CONTROL_RECIPIENT must be a public age recipient")'
fi
steps=${*:-claude codex openrouter opencode statements}
for s in $steps; do case $s in claude|claude-token|claude-token-2|claude-factory-token-2|claude-factory-token-3|codex|openrouter|opencode|opencode-2|r2|statements) ;; *) echo "unknown step $s" >&2; exit 1 ;; esac; done
umask 077
tmp=$(mktemp -d)
trap 'stty echo < /dev/tty 2>/dev/null; rm -rf "$tmp"' EXIT INT TERM
if [ $# -gt 0 ] && [ -f "$out" ]; then  # partial update: start from the current bundle
  [ ! -t 0 ] || { echo "pipe the founder identity on stdin to update $out" >&2; exit 1; }
  age -d -i /dev/stdin "$out" | tar -x -C "$tmp" || { echo "could not decrypt $out" >&2; exit 1; }
fi
secret() { printf '%s' "$1" > /dev/tty; stty -echo < /dev/tty; read -r v < /dev/tty; stty echo < /dev/tty; echo > /dev/tty; printf '%s\n' "$v"; }

for s in $steps; do case $s in
statements)
  [ ! -s "$tmp/statements-key" ] || { echo "statements key already exists; keeping it" >&2; }
  if [ ! -s "$tmp/statements-key" ]; then
    age-keygen -o "$tmp/statements-key" 2>/dev/null
  fi
  age-keygen -y "$tmp/statements-key" > "$tmp/statements-recipient.txt" ;;
claude|claude-token|claude-token-2|claude-factory-token-2|claude-factory-token-3)
  # 2026-10-20: `claude setup-token < /dev/tty` crashes Bun (kqueue EINVAL) when stdin is the identity pipe; get the
  # token first in a plain terminal (`claude setup-token`, signed in to the intended account), then paste it here.
  echo "Claude ($s). Paste the token from \`claude setup-token\` (run it first in a plain terminal, signed in to the intended account)."
  t=$(secret "Paste the Claude token: ")
  case $t in sk-ant-oat*) ;; *) echo "not a Claude subscription token (sk-ant-oat...)" >&2; exit 1 ;; esac
  printf '%s\n' "$t" > "$tmp/$( [ "$s" = claude ] && echo claude-token || echo "$s" )" ;;
codex)
  echo "Codex. A browser opens: sign in with the ChatGPT account. This is a separate session;"
  echo "this Mac's own Codex login is untouched (the exam relay renews its own copy)."
  rm -rf "$tmp/codex"; mkdir "$tmp/codex"
  CODEX_HOME="$tmp/codex" codex login -c 'cli_auth_credentials_store="file"' < /dev/tty
  [ -s "$tmp/codex/auth.json" ] || { echo "codex login wrote no auth.json" >&2; exit 1; }
  mv "$tmp/codex/auth.json" "$tmp/codex-auth.json"; rm -rf "$tmp/codex" ;;
openrouter)
  echo "OpenRouter. Create a key with a credit limit at https://openrouter.ai/settings/keys"
  k=$(secret "Paste the OpenRouter key: ")
  case $k in sk-or-*) ;; *) echo "not an OpenRouter key (sk-or-...)" >&2; exit 1 ;; esac
  printf '%s\n' "$k" > "$tmp/openrouter-key" ;;
opencode)
  echo "OpenCode Go (required by the factory: MiMo, Muse and GLM roles; use the second account). Key from https://opencode.ai/auth"
  k=$(secret "Paste the OpenCode Go key (Enter = this Mac's OpenCode login, - = skip): ")
  if [ -z "$k" ]; then  # the key `opencode auth login` already stored on this Mac
    k=$(python3 -c 'import json,os; print(json.load(open(os.path.expanduser("~/.local/share/opencode/auth.json")))["opencode-go"]["key"])' 2>/dev/null) ||
      { echo "no OpenCode Go login on this Mac; paste the key instead" >&2; exit 1; }
  fi
  if [ "$k" = - ]; then rm -f "$tmp/opencode-go-key"; else printf '%s\n' "$k" > "$tmp/opencode-go-key"; fi ;;
r2)  # 2026-10-20: Cloudflare R2 for checkpoints; stays on this Mac (the launcher pre-signs per-object links for VMs)
  echo "Cloudflare R2: a token with Object Read & Write on the factory bucket only (R2 > Manage API tokens)."
  a=$(secret "R2 Account ID: "); i=$(secret "R2 Access Key ID: "); k=$(secret "R2 Secret Access Key: ")
  printf 'Bucket name [unbug-factory]: ' > /dev/tty; read -r b < /dev/tty; b=${b:-unbug-factory}
  for v in "$a" "$i" "$k" "$b"; do case $v in ''|*[!A-Za-z0-9._/+=-]*) echo "empty or unexpected characters; nothing stored" >&2; exit 1 ;; esac; done
  printf 'R2_ACCOUNT_ID=%s\nR2_ACCESS_KEY_ID=%s\nR2_SECRET_ACCESS_KEY=%s\nR2_BUCKET=%s\n' "$a" "$i" "$k" "$b" > "$tmp/r2-env" ;;
opencode-2)  # 2026-10-19: a second subscription spreads MiMo/Muse/GLM limits (launch.sh OPENCODE_SECRET_NAME)
  k=$(secret "Paste the SECOND OpenCode Go key (from https://opencode.ai/auth on the other account): ")
  [ -n "$k" ] || { echo "no key entered" >&2; exit 1; }
  printf '%s\n' "$k" > "$tmp/opencode-go-key-2" ;;
esac; done

for need in claude-token codex-auth.json openrouter-key; do
  [ -s "$tmp/$need" ] || { echo "bundle would lack $need; run the matching step" >&2; exit 1; }
done
# The recipient is public; keep it out of the private bundle.
if [ -f "$tmp/statements-recipient.txt" ]; then
  statements_recipient=$(cat "$tmp/statements-recipient.txt")
  rm "$tmp/statements-recipient.txt"
fi
mkdir -p "$(dirname "$out")"
set -- -r "$recipient"
if [ -n "$control_recipient" ]; then set -- "$@" -r "$control_recipient"; fi
(cd "$tmp" && ls) | COPYFILE_DISABLE=1 tar -C "$tmp" -cf - -T - | age "$@" -o "$out.new"
mv "$out.new" "$out"
if [ -n "${statements_recipient:-}" ]; then
  printf '%s\n' "$statements_recipient" > "$root/factory/statements-recipient.txt"
  chmod 644 "$root/factory/statements-recipient.txt"
fi
echo "saved $out ($(cd "$tmp" && ls | tr '\n' ' ')), encrypted to the founder key${control_recipient:+ and control key}"
