#!/usr/bin/env python3
"""Host: bin/r2-presign GET|PUT <object-key> <seconds>. Prints a pre-signed R2 (S3 SigV4) URL for one object.
Credentials come from the environment (R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET); VMs only
ever receive the URL, never the keys (2026-10-20)."""
import datetime, hashlib, hmac, os, sys, urllib.parse


def presign(method, key, seconds, account, access, secret, bucket, now=None, host=None, region="auto"):
    now = now or datetime.datetime.now(datetime.timezone.utc)
    host = host or f"{account}.r2.cloudflarestorage.com"
    date, stamp = now.strftime("%Y%m%d"), now.strftime("%Y%m%dT%H%M%SZ")
    scope = f"{date}/{region}/s3/aws4_request"
    path = "/" + urllib.parse.quote(f"{bucket}/{key}" if bucket else key, safe="/~")
    query = {"X-Amz-Algorithm": "AWS4-HMAC-SHA256", "X-Amz-Credential": f"{access}/{scope}", "X-Amz-Date": stamp,
             "X-Amz-Expires": str(int(seconds)), "X-Amz-SignedHeaders": "host"}
    qs = "&".join(f"{urllib.parse.quote(k, safe='~')}={urllib.parse.quote(v, safe='~')}" for k, v in sorted(query.items()))
    request = "\n".join([method, path, qs, f"host:{host}\n", "host", "UNSIGNED-PAYLOAD"])
    to_sign = "\n".join(["AWS4-HMAC-SHA256", stamp, scope, hashlib.sha256(request.encode()).hexdigest()])
    k = ("AWS4" + secret).encode()
    for part in (date, region, "s3", "aws4_request"): k = hmac.new(k, part.encode(), hashlib.sha256).digest()
    return f"https://{host}{path}?{qs}&X-Amz-Signature={hmac.new(k, to_sign.encode(), hashlib.sha256).hexdigest()}"


if __name__ == "__main__":
    if len(sys.argv) != 4 or sys.argv[1] not in ("GET", "PUT") or not 1 <= int(sys.argv[3]) <= 7 * 86400:
        sys.exit("usage: r2-presign GET|PUT <object-key> <seconds up to 7 days>")
    env = [os.environ.get(n) for n in ("R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "R2_BUCKET")]
    if not all(env): sys.exit("R2 credentials missing from the environment")
    print(presign(sys.argv[1], sys.argv[2], sys.argv[3], *env))
