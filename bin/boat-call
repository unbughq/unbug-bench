#!/usr/bin/env python3
"""Bounded boat invocation. BOAT_CMD is an executable path, otherwise use the zsh function.
BOAT_COMMAND_TIMEOUT_SECONDS defaults to 120; stdin is forwarded only with --stdin.
"""
import os
import math
import signal
import subprocess
import sys


def main():
    args = sys.argv[1:]
    forward = args[:1] == ["--stdin"]
    if forward:
        args.pop(0)
    timeout = float(os.environ.get("BOAT_COMMAND_TIMEOUT_SECONDS", "120"))
    if not args or not math.isfinite(timeout) or timeout <= 0:
        sys.exit("boat-call: need a command and a positive finite timeout")
    cmd = [os.environ["BOAT_CMD"]] if os.environ.get("BOAT_CMD") else ["zsh", "-ic", 'boat "$@"', "zsh"]
    proc = None
    pending_signal = None

    def stop(signum, _frame):
        nonlocal pending_signal
        if proc is None:
            pending_signal = signum
            return
        try: os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        proc.wait()
        sys.exit(128 + signum)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    # Interactive zsh is needed for the Boat function, but Terminal session restore
    # messages corrupt version strings, JSON and remote file listings.
    proc = subprocess.Popen(cmd + args, stdin=None if forward else subprocess.DEVNULL,
                            env={**os.environ, "SHELL_SESSIONS_DISABLE": "1"}, start_new_session=True)
    if pending_signal is not None:
        stop(pending_signal, None)
    try:
        return proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        stop_message = f"boat {args[0]} timed out; remote outcome may be unknown"
        print(stop_message, file=sys.stderr)
        try: os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        proc.wait()
        return 124


if __name__ == "__main__":
    sys.exit(main())
