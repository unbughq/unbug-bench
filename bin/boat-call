#!/usr/bin/env python3
"""Invoke the pinned Boat executable without updates; BOAT_CMD may select a transport."""
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import processes

VERSION = 'boat 1.0.96'
CAPTURE_LIMIT = 8 * 1024 * 1024


def snapshot(stream, size):
    # Child and owner share an open-file description. Never move its offset:
    # an escaped appending writer could otherwise overwrite earlier output.
    data = bytearray()
    while len(data) < size:
        chunk = os.pread(stream.fileno(), min(65536, size - len(data)), len(data))
        if not chunk:
            raise OSError('captured output truncated')
        data.extend(chunk)
    return data



def main():
    args = sys.argv[1:]
    forward = args[:1] == ['--stdin']
    if forward: args.pop(0)
    if not args: return 2
    timeout = processes.positive(os.environ.get('BOAT_COMMAND_TIMEOUT_SECONDS', '120'))
    executable = os.environ.get('BOAT_CMD')
    if not executable:
        installed = Path.home() / '.ascii/bin/boat'
        executable = str(installed) if installed.is_file() else shutil.which('boat')
    if not executable: sys.exit('boat-call: pinned Boat executable not found')
    env = {**os.environ, 'BOAT_NO_UPDATE': '1', 'SHELL_SESSIONS_DISABLE': '1'}
    capture = env.pop('BOAT_CAPTURE_OUTPUT', None) == '1'
    def stop(signum, _frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGINT): signal.signal(sig, stop)
    try:
        with processes.deadline(timeout):
            # Production control uses BOAT_CMD=/usr/local/bin/boat and is pinned too.
            # Other executable names are explicit Hetzner/test transport adapters.
            if Path(executable).name == 'boat':
                version = processes.run([executable, '--version'], capture_output=True, text=True,
                                        env=env, stdin=subprocess.DEVNULL)
                if version.returncode or version.stdout.strip() != VERSION:
                    sys.exit('boat-call: Boat version mismatch; expected ' + VERSION)
            if capture:
                with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
                    result = processes.run([executable, *args],
                        stdin=None if forward else subprocess.DEVNULL,
                        stdout=out, stderr=err, env=env)
                    sizes = [os.fstat(stream.fileno()).st_size for stream in (out, err)]
                    if any(size > CAPTURE_LIMIT for size in sizes):
                        print('boat-call: captured metadata exceeds 8 MiB', file=sys.stderr)
                        return 125
                    try:
                        stdout, stderr = [snapshot(stream, size)
                                          for stream, size in zip((out, err), sizes)]
                    except OSError as error:
                        print('boat-call: capture failed: ' + str(error), file=sys.stderr)
                        return 125
                    sys.stdout.buffer.write(stdout)
                    sys.stderr.buffer.write(stderr)
                    return result.returncode
            result = processes.run([executable, *args], stdin=None if forward else subprocess.DEVNULL,
                                   env=env)
            return result.returncode
    except (OSError, ValueError, KeyError, TypeError):
        print('boat-call: managed command refused', file=sys.stderr)
        return 1
    except (subprocess.TimeoutExpired, TimeoutError):
        print('boat-call: command timed out; remote outcome may be unknown', file=sys.stderr)
        return 124


if __name__ == '__main__':
    sys.exit(main())
