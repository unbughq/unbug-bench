#!/usr/bin/env python3
"""Invoke the pinned Boat executable without updates; BOAT_CMD may select a transport."""
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import processes

VERSION = 'boat 1.0.85'


def main():
    args = sys.argv[1:]
    forward = args[:1] == ['--stdin']
    if forward: args.pop(0)
    if not args: return 2
    timeout = processes.positive(os.environ.get('BOAT_COMMAND_TIMEOUT_SECONDS', '120'))
    executable = os.environ.get('BOAT_CMD')
    if not executable:
        installed = Path.home() / '.ascii/bin/boat'
        executable = str(installed) if installed.is_file() else shutil.which('boat')
    if not executable: sys.exit('boat-call: pinned Boat executable not found')
    env = {**os.environ, 'BOAT_NO_UPDATE': '1', 'SHELL_SESSIONS_DISABLE': '1'}
    def stop(signum, _frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGINT): signal.signal(sig, stop)
    try:
        with processes.deadline(timeout):
            # Production control uses BOAT_CMD=/usr/local/bin/boat and is pinned too.
            # Other executable names are explicit Hetzner/test transport adapters.
            if Path(executable).name == 'boat':
                version = processes.run([executable, '--version'], capture_output=True, text=True,
                                        env=env, stdin=subprocess.DEVNULL)
                if version.returncode or version.stdout.strip() != VERSION:
                    sys.exit('boat-call: Boat version mismatch; expected ' + VERSION)
            result = processes.run([executable, *args], stdin=None if forward else subprocess.DEVNULL,
                                   env=env)
            return result.returncode
    except subprocess.TimeoutExpired:
        print('boat-call: command timed out; remote outcome may be unknown', file=sys.stderr)
        return 124


if __name__ == '__main__':
    sys.exit(main())
