#!/usr/bin/env python3
"""Run one explicitly authorized rehearsal job through the existing key holder."""
import argparse
import json
import pathlib
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--policy", type=pathlib.Path, required=True)
parser.add_argument("--job", required=True)
args = parser.parse_args()
job = json.loads(args.policy.read_text())["jobs"][args.job]
if job.get("mode") != "rehearsal" or "--rehearse-only" not in job.get("args", []):
    parser.error("job must explicitly authorize a fresh-worker rehearsal")
sys.path.insert(0, str(root / "factory"))
import key_holder
policy = key_holder.policy_load(args.policy.resolve())
if key_holder.request({"op": "status"}).get("policy_sha256") != key_holder.policy_digest(policy):
    parser.error("active holder must be unlocked with this exact rehearsal policy")
raise SystemExit(subprocess.call([
    sys.executable, str(root / "factory/key_holder.py"), "launch",
    "--policy", str(args.policy), "--job", args.job,
]))
