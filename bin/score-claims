#!/usr/bin/env python3
"""Score claims against a stored checkpoint, including its resolved pending delivery.

  bin/score-claims <checkpoint.json> <claims.json> [<questions.jsonl> <step>]
"""
import json, pathlib, sys
import claims

checkpoint_path = pathlib.Path(sys.argv[1]).resolve()
checkpoint = json.loads(checkpoint_path.read_text())
if not claims.verify_pending_artifacts(checkpoint, checkpoint_path.parent):
    checkpoint["pending_verification"] = {}
result = claims.score(json.loads(pathlib.Path(sys.argv[2]).read_text()), checkpoint, checkpoint["key"],
                      claims.step_questions(sys.argv[3], sys.argv[4]) if len(sys.argv) > 4 else 0)
print(json.dumps(result, indent=2))
