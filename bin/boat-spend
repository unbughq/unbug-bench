#!/usr/bin/env python3
"""Print boat dollars left (BOAT_CMD supported). Launchers also use --check/--finish.
--check VMS TTL_HOURS MAX_SPEND RECORD [STATE]; --finish RECORD EXIT_CODE IDS_FILE.
--settle RECORD STATE verifies deletion and attributes lifetime machine usage.
--total prints every Hetzner server's cost so far (results/spend/hcloud-hosts.jsonl, live ones to now).
Observes account balance deltas without attributing concurrent activity to a worker. With
BOAT_CMD=bin/hcloud-boat (Hetzner: no balance API) the cap uses the dearest type in HCLOUD_PLACES at its live
Hetzner price, and the finish record prices each server's billed hours. On Boat TTL pricing is an estimate, never a guaranteed billing ceiling.
Boat liability persists until attributed settlement; settled charges remain cumulative.
2026-10-18: a fixed cx price under-reported cpx servers 2-4x and the cap never fired; prices are now live.
"""
import datetime
import decimal
import fcntl
import json
import math
import os
import pathlib
import subprocess
import sys
import time
import processes
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "factory"))
import boat_lifecycle as lifecycle

D = decimal.Decimal
CALL = pathlib.Path(__file__).with_name("boat-call")
HETZNER = os.path.basename(os.environ.get("BOAT_CMD", "")) == "hcloud-boat"
HOSTS = pathlib.Path(__file__).resolve().parents[1] / "results/spend/hcloud-hosts.jsonl"
USD_PER_EUR = D("1.2")  # conservative upper bound for the USD cap
BOAT_USD_PER_HOUR = {"small": D("0.018"), "default": D("0.036"), "large": D("0.072"), "xlarge": D("0.20")}  # boat new --help, 2026-10-18
_prices = {}


def eur_per_hour(stype, location=None):
    """Live gross hourly list price + IPv4 at location (unknown location: the dearest); unknown types raise."""
    if stype not in _prices:
        info = json.loads(processes.run(["hcloud", "server-type", "describe", stype, "-o", "json"], capture_output=True, text=True, check=True).stdout)
        _prices[stype] = {p["location"]: D(p["price_hourly"]["gross"]) + D("0.0008") for p in info["prices"]}
    return _prices[stype].get(location) or max(_prices[stype].values())


def hetzner_cost(ids=None):
    """EUR for these servers (default: every server logged): Hetzner bills each started hour from creation to deletion."""
    events = [json.loads(l) for l in HOSTS.read_text().splitlines() if l.strip()] if HOSTS.exists() else []
    if ids is None: ids = sorted({e["id"] for e in events if e.get("event") == "created"})
    total = D(0)
    for sid in ids:
        made = [e for e in events if e.get("id") == sid and e["event"] == "created"]
        gone = [e for e in events if e.get("id") == sid and e["event"] == "deleted"]
        if not made:
            continue
        end = gone[-1]["ts"] if gone else datetime.datetime.now().timestamp()
        hours = max(1, math.ceil((end - made[-1]["ts"]) / 3600))
        total += hours * eur_per_hour(made[-1]["type"], made[-1].get("location"))
    return total


def balance(query=None):
    data = (query("billing", "--json") if query else
            json.loads(processes.run([str(CALL), "billing", "--json"], capture_output=True, text=True, check=True).stdout))
    value = D(str(data["limits"]["creditBalanceSeconds"])) / 100000
    if not value.is_finite() or value < 0:
        raise ValueError("invalid credit balance")
    return value


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def write(path, data):
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    def numeric(value):
        if isinstance(value, D): return float(value)
        raise TypeError("invalid JSON value")
    with tmp.open('w') as stream:
        json.dump(data, stream, indent=2, default=numeric)
        stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
    tmp.replace(path)
    directory = os.open(path.parent, os.O_RDONLY)
    try: os.fsync(directory)
    finally: os.close(directory)


read_ledger = lifecycle.read_ledger

def main():
    # One control host owns admission. Never silently drop an uncertain hold.
    home = pathlib.Path(os.environ.get('UNBUG_CONTROL_HOME', str(pathlib.Path.home() / '.unbug-control')))
    if not HETZNER and len(sys.argv) > 1 and sys.argv[1] in ('--check', '--finish', '--settle'):
        home.mkdir(parents=True, exist_ok=True)
        with (home / 'boat-reservations.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return accounting(home / 'boat-reservations.json')
    return accounting(None)


def accounting(ledger_path):
    ledger = read_ledger(ledger_path)
    deadline = time.monotonic() + 40
    def query(*args):
        remaining = deadline - time.monotonic()
        if remaining <= 0: raise TimeoutError()
        response = subprocess.run([str(CALL), *args], capture_output=True, text=True, check=True,
            timeout=remaining + 70, env={**os.environ, "BOAT_COMMAND_TIMEOUT_SECONDS": str(min(10, remaining))})
        if time.monotonic() >= deadline: raise TimeoutError()
        return lifecycle.loads(response.stdout)
    def save_ledger():
        if ledger_path: write(ledger_path, ledger)
    def settle(path, state):
        key = str(pathlib.Path(path).resolve())
        row = ledger['reservations'][key]
        state = str(pathlib.Path(state).resolve())
        if row.get('state_path') != state: raise ValueError('unbound state')
        data = json.loads(lifecycle.regular(path), object_pairs_hook=lifecycle.unique_object)
        if (data.get('provider') != 'boat' or data.get('allowed') is not True or
                data.get('vms') != row['vms'] or data.get('ttl_seconds') != row['ttl_seconds'] or
                D(str(data.get('max_spend_usd'))) != lifecycle.number(row['max_spend_usd'])):
            raise ValueError('envelope mismatch')
        if row['status'] != 'settled':
            if row['status'] not in ('reserved', 'finished'): raise ValueError('unknown liability')
            proof = lifecycle.settlement_proof(path, state, row, query)
            amount = lifecycle.total(lifecycle.number(w['dollars']) for w in proof['workers'])
            updated = dict(row, status='settled', settlement=proof, actual_spend_usd=format(amount, 'f'))
            lifecycle.settlement_amount(updated)
            ledger['reservations'][key] = updated
            save_ledger()
            row = updated
        data.update(settlement=row['settlement'], actual_spend_usd=float(lifecycle.settlement_amount(row)))
        write(path, data)
    def try_settle(path, state):
        try:
            settle(path, state)
            return True
        except (ValueError, KeyError, TypeError, OSError, decimal.DecimalException, subprocess.SubprocessError):
            return False
    if len(sys.argv) == 1:
        print(balance())
    elif sys.argv[1] == "--total":
        print(f"Hetzner so far: EUR {hetzner_cost():.2f}")
    elif sys.argv[1] == "--check":
        count, hours, cap, path = sys.argv[2:6]
        state = str(pathlib.Path(sys.argv[6]).resolve()) if len(sys.argv) == 7 else None
        if len(sys.argv) not in (6, 7): raise ValueError()
        count, hours, cap = int(count), D(hours), D(cap)
        if count < 1 or not hours.is_finite() or hours <= 0 or not cap.is_finite() or cap < 0:
            raise ValueError("VM count and TTL must be positive; max-spend must be nonnegative")
        seconds = int((hours * 3600).to_integral_value(rounding=decimal.ROUND_CEILING))
        hours = D(seconds) / 3600
        before = None
        if HETZNER:
            types = {p.partition("@")[0] for p in os.environ.get("HCLOUD_PLACES", "cx33@fsn1").split()}
            rate = max(eur_per_hour(t) for t in types) * USD_PER_EUR
        else:
            rate = BOAT_USD_PER_HOUR[os.environ.get("BOAT_TYPE", "default")]
        estimate = count * hours * rate
        key = str(pathlib.Path(path).resolve())
        holds = ledger['reservations']
        previous = holds.get(key)
        refusal = None
        if previous and previous['status'] != 'reserved':
            refusal = 'completed reservation cannot be reused'
        elif previous and (D(str(previous['usd'])) != estimate or
                ('state_path' in previous and (previous['state_path'] != state or
                 previous['vms'] != count or previous['ttl_seconds'] != seconds or
                 lifecycle.number(previous['max_spend_usd']) != cap)) or
                ('state_path' not in previous and state is not None)):
            refusal = 'reservation envelope changed'
        elif any(k != key and row['status'] != 'settled' for k, row in holds.items()):
            refusal = 'infrastructure liability unsettled'
        elif previous is None and state is not None and any(r.get('state_path') == state for r in holds.values()):
            refusal = 'reservation state already bound'
        elif not HETZNER and previous is None and os.path.lexists(path):
            refusal = 'unledgered spend record exists'
        else:
            before = None if HETZNER else balance(query)
            charges = lifecycle.total(lifecycle.settlement_amount(r) for r in holds.values() if r["status"] == "settled")
            caps = [cap] + [lifecycle.number(r["max_spend_usd"]) for r in holds.values() if "max_spend_usd" in r]
            if lifecycle.total([charges, estimate]) > min(caps) or (not HETZNER and estimate > before):
                refusal = 'estimated batch cost exceeds balance or --max-spend'
        allowed = refusal is None
        if allowed and ledger_path:
            holds[key] = previous or dict(usd=str(estimate), expires_at=time.time() + seconds + 1800,
                                         status='reserved', state_path=state, vms=count,
                                         ttl_seconds=seconds, max_spend_usd=str(cap))
            save_ledger()
        data = dict(started_at=now(), vms=count, ttl_seconds=seconds,
                    estimated_usd=float(estimate), max_spend_usd=float(cap),
                    provider="hetzner" if HETZNER else "boat",
                    balance_before_usd=None if before is None else float(before), balance_after_usd=None,
                    actual_spend_usd=None, allowed=allowed)
        if refusal: data['refusal'] = refusal
        # Neither refused admission nor accepted replay erases lifecycle evidence.
        if not pathlib.Path(path).exists() or (allowed and previous is None):
            write(path, data)
        if refusal: raise ValueError(refusal)
        print('TTL-priced estimate admitted; not a hard billing ceiling', file=sys.stderr)
        print(seconds)
    elif sys.argv[1] == "--settle":
        if HETZNER or len(sys.argv) != 4 or not try_settle(*sys.argv[2:]):
            raise ValueError("infrastructure settlement unavailable")
    elif sys.argv[1] == "--finish":
        path, code, ids_file = sys.argv[2:]
        data = json.loads(pathlib.Path(path).read_text())
        hold = ledger['reservations'].get(str(pathlib.Path(path).resolve()))
        if hold and hold.get('state_path') and str(pathlib.Path(ids_file).resolve().parent) != hold['state_path']:
            raise ValueError('infrastructure settlement unavailable')
        if hold and hold['status'] == 'settled':
            if not data.get('finished_at'):
                data.update(finished_at=now(), exit_code=int(code), ids=pathlib.Path(ids_file).read_text().split())
                write(path, data)
            if not try_settle(path, hold['state_path']): raise ValueError('infrastructure settlement unavailable')
            return
        if data.get("finished_at"):
            if hold:
                hold.update(status='finished', finished_at=data['finished_at'], actual_spend_usd=None)
                save_ledger()
                if hold.get('state_path') and not try_settle(path, hold['state_path']):
                    print('WARNING: infrastructure settlement unavailable', file=sys.stderr)
            return
        data.update(finished_at=now(), exit_code=int(code), ids=pathlib.Path(ids_file).read_text().split())
        if data.get("provider") == "hetzner":
            cost = hetzner_cost(data["ids"])
            data.update(actual_spend_eur=float(cost))
            print(f"Actual spend (billed hours x list price): EUR {cost:.4f}", file=sys.stderr)
            write(path, data)
            return
        try:
            after = balance(query)
            delta = D(str(data["balance_before_usd"])) - after
            data.update(balance_after_usd=float(after), actual_spend_usd=None,
                        account_balance_delta_usd=float(delta), attribution='account_observation')
            print(f"Account observation (not lifecycle spend): delta ${delta:.5f}; balance ${after:.5f}", file=sys.stderr)
        except Exception:
            data["balance_after_error"] = "balance_unavailable"
            print("WARNING: account balance unavailable", file=sys.stderr)
        write(path, data)
        hold = ledger['reservations'].get(str(pathlib.Path(path).resolve()))
        if hold:
            hold.update(status='finished', finished_at=data['finished_at'], actual_spend_usd=None)
            save_ledger()
            if hold.get('state_path') and not try_settle(path, hold['state_path']):
                print('WARNING: infrastructure settlement unavailable', file=sys.stderr)
    else:
        raise ValueError(__doc__)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, TypeError, OSError, decimal.DecimalException, subprocess.SubprocessError) as exc:
        labels = {'reservation state already bound', 'unledgered spend record exists', 'infrastructure settlement unavailable', 'invalid reservation ledger', 'invalid credit balance',
                  'VM count and TTL must be positive; max-spend must be nonnegative',
                  'completed reservation cannot be reused', 'reservation envelope changed',
                  'infrastructure liability unsettled',
                  'estimated batch cost exceeds balance or --max-spend'}
        label = str(exc) if type(exc) is ValueError and str(exc) in labels else 'accounting unavailable'
        sys.exit('boat-spend: ' + label)
