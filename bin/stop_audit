#!/usr/bin/env python3
"""Is each known factory bug class fixed? Read-only, from the recorded step attempts.

  <controller venv>/bin/python -B bin/stop_audit --config <campaign config> --repo <git checkout> [--since <iso>] [--releases DIR] [--json]

Reads every step attempt from the DBOS tables (one read-only transaction), maps each plumbing
release to its commit (control/release.py records under --releases, default ~/.unbug-release) and
judges each reason against factory/durable/stop_registry.py:
  REGRESSION  a bug reason on a release whose commit contains its fix: the fix did not work
  OPEN        a bug reason with no fix yet
  UNKNOWN     a reason the registry does not know
  UNCHECKED   a fixed bug on a release whose commit, or its ancestry in --repo, is unknown
Exit 1 if any REGRESSION or UNKNOWN.
"""
import argparse
from datetime import datetime
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "factory"))
from durable.runtime import load_config  # noqa: E402
from durable.stop_registry import audit, git_contains, read_attempts, release_commits  # noqa: E402


def render(report: dict) -> str:
    short = lambda v: (v or "?")[:12]
    lines = []
    for label in ("regression", "unknown", "unchecked", "open"):
        for r in report[label]:
            extra = f" fixed_in {short(r['fixed_in'])} test {r['test']}" if "fixed_in" in r else ""
            lines.append(f"{label.upper():<10} {r['reason']:<40} {r['count']:>4}x release {short(r['release'])} "
                         f"(commit {short(r['commit'])}) {len(r['cases'])} cases{extra}")
    for pv, rel in sorted(report["releases"].items(), key=lambda kv: kv[0] or ""):
        lines.append(f"RELEASE    {short(pv)} commit {short(rel['commit'])}: {rel['attempts']} attempts, "
                     f"{rel['infra']} infra stops")
    return "\n".join(lines)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--config", type=Path, required=True, help="campaign config (runtime.load_config)")
    parser.add_argument("--repo", type=Path, help="git checkout holding the release and fix commits")
    parser.add_argument("--releases", type=Path, default=Path.home() / ".unbug-release",
                        help="control/release.py --work directory")
    parser.add_argument("--since", type=datetime.fromisoformat, help="only attempts started at or after (ISO)")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    rows = read_attempts(load_config(args.config)["database_url"])
    if args.since:
        since = args.since.timestamp()
        rows = [r for r in rows if (r["started_at"] or 0) >= since]
    report = audit(rows, release_commits(args.releases), git_contains(args.repo) if args.repo else None)
    print(json.dumps(report, sort_keys=True) if args.json else render(report))
    return 1 if report["regression"] or report["unknown"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
