#!/usr/bin/env python3
"""Is each known factory bug class fixed? Read-only, from the recorded step attempts.

  <controller venv>/bin/python -B bin/stop_audit --config <campaign config> [--repo <git checkout>]
      [--since <iso> | --last-hours N] [--releases DIR] [--release-map FILE] [--json | --write FILE]

Reads the step attempts from the DBOS tables (one read-only transaction with a 30 s statement
timeout), maps each plumbing release to its commit (the store's release-commits.json, or
--release-map, and control/release.py records under --releases, default ~/.unbug-release) and
judges each reason against factory/durable/stop_registry.py:
  REGRESSION  a bug reason on a release whose commit contains its fix: the fix did not work
  OPEN        a bug reason with no fix yet, or one that collects several causes
  UNKNOWN     a reason the registry does not know
  UNCHECKED   a fixed bug on a release whose commit, or its ancestry in --repo, is unknown
  INVARIANT   a live money or progress invariant broken (stop_registry.invariants): booked spend
              below reported usage or a batch over its bound, waste on a case's own money, a live
              case stuck over 2 hours, or one attempt recorded with two results
--repo defaults to $UNBUG_STOP_AUDIT_REPO (a plain clone of a git bundle of main is enough).
--write records the result atomically as JSON at <state_dir>/stop-audit.json (the config's state_dir,
where the campaign guard reads it; or at a given path). control/campaign/unbug-stop-audit.timer runs
this every 10 minutes as `user`.
Exit 3 if any REGRESSION, UNKNOWN or INVARIANT; any other non-zero exit is the audit itself failing.
"""
import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "factory"))
from durable.guard import STOP_AUDIT_FILE  # noqa: E402
from durable.runtime import load_config  # noqa: E402
from durable.stop_registry import (audit, git_contains, invariants, read_attempts, read_invariant_inputs,  # noqa: E402
                                   release_commits, render, result)
from durable.workers import _atomic_json  # noqa: E402


FINDINGS = 3   # REGRESSION or UNKNOWN; distinct from a crash (1) so the timer unit can tell them apart


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--config", type=Path, required=True, help="campaign config (runtime.load_config)")
    parser.add_argument("--repo", type=Path, default=os.environ.get("UNBUG_STOP_AUDIT_REPO") or None,
                        help="git checkout holding the release and fix commits")
    parser.add_argument("--releases", type=Path, default=Path.home() / ".unbug-release",
                        help="control/release.py --work directory")
    parser.add_argument("--release-map", type=Path,
                        help="release -> commit JSON map (default <state_dir>/releases/release-commits.json)")
    window = parser.add_mutually_exclusive_group()
    window.add_argument("--since", type=datetime.fromisoformat, help="only attempts started at or after (ISO)")
    window.add_argument("--last-hours", type=float, help="only attempts started in the last N hours")
    out = parser.add_mutually_exclusive_group()
    out.add_argument("--json", action="store_true", help="print the full report as JSON")
    out.add_argument("--write", type=Path, nargs="?", const=True, metavar="PATH",
                     help="write the guard's result JSON atomically (default <state_dir>/stop-audit.json)")
    args = parser.parse_args(argv)
    now = time.time()
    since = (args.since.timestamp() if args.since else
             now - args.last_hours * 3600 if args.last_hours is not None else None)
    config = load_config(args.config)
    rows, undecodable = read_attempts(config["database_url"], since)
    release_map = args.release_map or Path(config["state_dir"]) / "releases/release-commits.json"
    report = audit(rows, release_commits(args.releases, release_map), git_contains(args.repo) if args.repo else None)
    try:
        violations = invariants(rows, *read_invariant_inputs(config))
    except Exception as error:   # a check that cannot run is reported, never passed silently
        violations = [("invariants_unchecked", f"INVARIANT  invariants_unchecked  {type(error).__name__}")]
    if args.write:
        path = Path(config["state_dir"]) / STOP_AUDIT_FILE if args.write is True else args.write
        _atomic_json(path, result(report, undecodable, now, violations))
    elif args.json:
        print(json.dumps({**report, "undecodable": undecodable, "invariant": [l for _, l in violations]},
                         sort_keys=True))
    else:
        print("\n".join([l for _, l in violations] + render(report) + [f"UNDECODABLE {undecodable} outputs"]))
    return FINDINGS if report["regression"] or report["unknown"] or violations else 0


if __name__ == "__main__":
    raise SystemExit(main())
