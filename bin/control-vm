#!/usr/bin/env python3
"""Provision the control VM, using the active hcloud context. No worker/R2 operations.

  control-vm create [--name unbug-control] [--location nbg1]
  control-vm setup|boat-login|migrate|status [--name unbug-control]
  control-vm destroy EXACT_SERVER_NAME --yes

setup prints only the public age recipient on stdout, even if activation fails.
It never uploads credentials, policies or launch journals. The public source
helpers bin/push-secrets and bin/setup-secrets are included.
See control/setup.sh and control/holder-command.sh for activation prerequisites.
"""
import argparse
import fnmatch
import hashlib
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
LABEL = 'unbug-control'
REMOTE = '/home/user/unbug-bench'
RULES = [dict(direction='in', protocol='tcp', port='22',
              source_ips=['0.0.0.0/0', '::/0'])]
DOCS = ('README.md', 'FACTORY.md', 'SPEC.md', 'PROTOCOL.md', 'V2.md',
        'DESIGN.md', 'CONTESTANT.md', 'BRIEF-v2.md')


def run(argv, **kwargs):
    return subprocess.run(argv, check=True, text=True, **kwargs)


def cloud(*args):
    return json.loads(run(['hcloud', *args, '-o', 'json'],
                          stdin=subprocess.DEVNULL, capture_output=True).stdout)


def servers():
    return cloud('server', 'list', '-l', LABEL + '=1') or []


def selected(name):
    rows = servers()
    if len(rows) != 1 or rows[0]['name'] != name or rows[0].get('labels', {}).get(LABEL) != '1':
        raise ValueError('expected exactly one labelled control server with name ' + name)
    return rows[0]


def firewall():
    rows = cloud('firewall', 'list', '-l', LABEL + '=1') or []
    if len(rows) > 1:
        raise ValueError('multiple control firewalls; reconcile manually')
    if rows:
        fw = rows[0]
        normalized = [{k: r[k] for k in ('direction', 'protocol', 'port', 'source_ips') if k in r}
                      for r in fw.get('rules', [])]
        if normalized != RULES or any(r.get('destination_ips') for r in fw.get('rules', [])):
            raise ValueError('existing control firewall is not SSH-only; refusing to reuse it')
        return str(fw['id'])
    with tempfile.NamedTemporaryFile('w') as f:
        json.dump(RULES, f); f.flush()
        return str(cloud('firewall', 'create', '--name', LABEL, '--label', LABEL + '=1',
                         '--rules-file', f.name)['firewall']['id'])


def ssh_options(server):
    # Same key and per-server known_hosts convention as bin/hcloud-boat.
    state = Path.home() / '.cache/unbug-bench/hcloud'
    state.mkdir(parents=True, exist_ok=True)
    return ['-i', str(Path.home() / '.ssh/unbug-bench-hcloud'),
            '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
            '-o', 'StrictHostKeyChecking=accept-new',
            '-o', f'UserKnownHostsFile={state / (str(server["id"]) + ".known_hosts")}',
            '-o', 'ServerAliveInterval=30', '-o', 'ServerAliveCountMax=4']


def host(server, user='user'):
    return user + '@' + server['public_net']['ipv4']['ip']


def ssh(server, command, *, user='user', data=None, capture=False):
    return run(['ssh', *ssh_options(server), host(server, user), command],
               input=data, stdin=subprocess.DEVNULL if data is None else None,
               stdout=subprocess.PIPE if capture else None,
               stderr=subprocess.PIPE if capture else None)


def sync(server, base, names, destination, *, private=False):
    # An explicit NUL-delimited file list avoids broad repo uploads or shell glob expansion.
    with tempfile.NamedTemporaryFile('wb') as f:
        f.write(b''.join(os.fsencode(n) + b'\0' for n in names)); f.flush()
        args = ['rsync', '-rptz', '--from0', '--files-from=' + f.name,
                '--no-links', '--no-devices', '--no-specials']
        run([*args, '-e', shlex.join(['ssh', *ssh_options(server)]),
             str(base) + '/', host(server) + ':' + destination + '/'], stdin=subprocess.DEVNULL)
    if private:
        # macOS ships openrsync, which has no --chmod; tighten modes on the VM instead.
        ssh(server, 'chmod -R go-rwx ' + shlex.quote(destination))


def public_files():
    def allowed(name):
        return (not name.startswith('.') and name != '__pycache__' and
                name.lower() not in ('sealed', 'results', 'node_modules') and
                not any(word in name.lower() for word in ('secrets', 'canary', 'bundle')))

    names = [name for name in DOCS if (ROOT / name).is_file() and not (ROOT / name).is_symlink()]
    for top in ('factory', 'bin', 'tools', 'control'):
        if (ROOT / top).is_symlink():
            raise ValueError('symlink public source directory: ' + top)
        for directory, dirs, files in os.walk(ROOT / top, followlinks=False):
            dirs[:] = sorted(d for d in dirs if allowed(d) and not (Path(directory) / d).is_symlink())
            for name in sorted(files):
                path = Path(directory) / name
                public_helper = path.relative_to(ROOT).as_posix() in ('bin/push-secrets', 'bin/setup-secrets')
                if ((allowed(name) or public_helper) and path.is_file() and not path.is_symlink() and
                        (path.suffix in ('.py', '.sh', '.md', '.txt', '.json', '.html', '.toml', '.yaml', '.yml', '.service', '.timer')
                         or (top == 'bin' and not path.suffix))):
                    names.append(path.relative_to(ROOT).as_posix())
    return sorted(names)


def setup(server):
    script = (ROOT / 'control/setup.sh').read_text()
    ssh(server, 'sh -s -- bootstrap', user='root', data=script)
    sync(server, ROOT, public_files(), REMOTE)
    # Key generation is part of the remote script. Only age-keygen -y may reach stdout.
    recipient = ssh(server, 'sh -s -- key-and-units', user='root', data=script, capture=True).stdout.strip()
    if not recipient.startswith('age1') or not recipient.isalnum():
        raise ValueError('remote setup did not return a public age recipient')
    print(recipient, flush=True)
    ssh(server, 'sh -s -- activate', user='root', data=script)


def boat_login(server):
    # Never inherit output streams for commands which may echo a newly minted key.
    # Only memory and the SSH stdin pipe carry the secret; no temporary file/argv.
    env = {**os.environ, 'BOAT_NO_UPDATE': '1'}
    # The Mac's boat lives in ~/.ascii/bin, which non-interactive shells lack; BOAT_CMD names it.
    boat = os.environ.get('BOAT_CMD') or shutil.which('boat') or os.path.expanduser('~/.ascii/bin/boat')
    help_text = run([boat, 'api-key', 'create', '--help'], stdin=subprocess.DEVNULL,
                    capture_output=True, env=env).stdout
    # boat 1.0.66: `api-key create [OPTIONS] [NAME]`; the name is positional.
    if '[NAME]' not in help_text or '--json' not in help_text:
        raise ValueError('Boat api-key create must accept [NAME] and --json; no key created')
    response = run([boat, 'api-key', 'create', 'unbug-control-' + server['name'], '--json'],
                   stdin=subprocess.DEVNULL, capture_output=True, env=env).stdout
    result = None
    try:
        result = json.loads(response)
        secret = result['secret']
        key = result['apiKey']
        metadata = {'id': key['id'], 'prefix': key['keyPrefix'], 'last4': key['keyLastFour']}
        if (not isinstance(secret, str) or not secret or any(c.isspace() for c in secret) or
                any(not isinstance(v, str) or not v or secret in v for v in metadata.values())):
            raise ValueError()
    except (ValueError, KeyError, TypeError):
        # Field names only, never values: the response holds the new secret.
        shape = sorted(result) if isinstance(result, dict) else type(result).__name__
        raise ValueError('invalid Boat API-key response, fields ' + str(shape) +
                         '; revoke unbug-control-' + server['name'] + ' in Boat') from None
    # Print revocation identifiers even if the following handoff fails.
    print(json.dumps(metadata, sort_keys=True), flush=True)
    ssh(server, 'BOAT_NO_UPDATE=1 runuser -u user -- /usr/local/bin/boat login --key-stdin',
        user='root', data=secret + '\n', capture=True)
    ssh(server, 'BOAT_NO_UPDATE=1 /usr/local/bin/boat list --json', capture=True)


def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b''):
            h.update(chunk)
    return h.hexdigest()


def migration_files(base):
    if base.is_symlink() or not base.is_dir():
        raise ValueError('expected a regular sealed directory')
    patterns = ('*.statement.age', '*.scorecard.json', '*.casekey.age', '*.search.age', '*.tar.gz.age')
    names = []
    for directory, dirs, files in os.walk(base, followlinks=False):
        for name in dirs + files:
            if (Path(directory) / name).is_symlink():
                raise ValueError('refusing a symlink in migration source')
        for name in files:
            path = Path(directory) / name
            rel = path.relative_to(base)
            if (rel.parts[0] == 'statement-registry' or any(fnmatch.fnmatchcase(name, p) for p in patterns)):
                if not path.is_file():
                    raise ValueError('migration source is not a regular file')
                names.append(rel.as_posix())
    return sorted(names)


REMOTE_HASH = '''import hashlib, json, pathlib, sys
base = pathlib.Path.home() / 'unbug-bench/sealed'
out = {}
for name in json.load(sys.stdin):
    rel = pathlib.PurePosixPath(name)
    if rel.is_absolute() or '..' in rel.parts:
        raise ValueError('unsafe manifest path')
    p = base / name
    if any(v.is_symlink() for v in [p, *p.parents]):
        raise ValueError('symlink in remote sealed path')
    if sys.argv[1] == 'prepare':
        if p.exists() and not p.is_file():
            raise ValueError('non-file migration destination')
        continue
    h = hashlib.sha256()
    with p.open('rb') as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b''):
            h.update(chunk)
    out[name] = h.hexdigest()
if sys.argv[1] == 'prepare':
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    base.chmod(0o700)
print(json.dumps(out, sort_keys=True))
'''


def migrate(server):
    base = ROOT / 'sealed'
    names = migration_files(base)
    if not names:
        raise ValueError('no migration files found')
    before = {name: digest(base / name) for name in names}
    ssh(server, 'python3 -c ' + shlex.quote(REMOTE_HASH) + ' prepare', data=json.dumps(names), capture=True)
    sync(server, base, names, REMOTE + '/sealed', private=True)
    remote = json.loads(ssh(server, 'python3 -c ' + shlex.quote(REMOTE_HASH) + ' verify',
                            data=json.dumps(names), capture=True).stdout)
    after = {name: digest(base / name) for name in migration_files(base)}
    if before != remote or before != after:
        raise ValueError('SHA256 verification failed or source changed; Mac files retained, rerun when quiescent')
    print(f'Verified {len(names)} files by SHA256 on Mac and VM; Mac files retained unchanged.')


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest='op', required=True)
    for op in ('create', 'setup', 'boat-login', 'migrate', 'status'):
        p = commands.add_parser(op)
        p.add_argument('--name', default=LABEL)
        if op == 'create':
            p.add_argument('--location', default='nbg1')
    p = commands.add_parser('destroy')
    p.add_argument('name', help='exact current server name (no default)')
    p.add_argument('--yes', action='store_true')
    args = parser.parse_args()
    if args.op == 'destroy' and not args.yes:
        parser.error('destroy requires --yes and the exact server name')
    if args.op == 'create':
        if servers():
            raise ValueError('refusing: a server labelled unbug-control=1 already exists')
        fw = firewall()
        data = cloud('server', 'create', '--name', args.name, '--type', 'cx23',
                     '--image', 'ubuntu-24.04', '--location', args.location,
                     '--ssh-key', 'unbug-bench', '--firewall', fw, '--without-ipv6', '--label', LABEL + '=1')
        print(data['server']['public_net']['ipv4']['ip'])
        return
    server = selected(args.name)
    if args.op == 'setup':
        setup(server)
    elif args.op == 'boat-login':
        boat_login(server)
    elif args.op == 'migrate':
        migrate(server)
    elif args.op == 'status':
        print(json.dumps({k: server[k] for k in ('id', 'name', 'status')}, sort_keys=True), flush=True)
        ssh(server, 'systemctl show unbug-key-holder.service unbug-resume-launches.service unbug-resume-launches.timer '
            '-p Id -p LoadState -p ActiveState -p SubState; '
            'if [ -d ~/.unbug-control/launches ]; then '
            'find ~/.unbug-control/launches -maxdepth 2 -print; fi')
    else:
        run(['hcloud', 'server', 'delete', str(server['id'])], stdin=subprocess.DEVNULL)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as e:
        # Do not echo provider/SSH output: future setup failures may contain private diagnostics.
        print('control-vm: ' + (str(e) if isinstance(e, ValueError) else
                              'command failed; reconcile server state before retrying'), file=sys.stderr)
        sys.exit(1)
